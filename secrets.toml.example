# Copy to .streamlit/secrets.toml (never commit the real one).

[admin]
password = "change-me-to-a-long-passphrase"

[google_sheet]
spreadsheet_id = "PASTE_THE_ID_FROM_THE_SHEET_URL"
worksheet = "Clients"          # tab name; created automatically if missing

# Service-account JSON from Google Cloud, pasted key by key.
# Share the Google Sheet with the "client_email" below (Editor access).
[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "something@your-project.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."

# ---------- Client documents in Google Drive (REQUIRED on Streamlit Community Cloud) ----------
# folder_id = the last part of the Drive folder URL: drive.google.com/drive/folders/<THIS_PART>
#
# Option A – Google Workspace: put the folder in a SHARED DRIVE and add the service account's
#            client_email as "Content manager". Only folder_id is needed:
# Option B – personal Gmail: service accounts have NO storage quota in a personal Drive, so use
#            your own account via OAuth. Run get_drive_token.py once and paste all 4 values.
[drive]
folder_id = "PASTE_FOLDER_ID"
# client_id = "....apps.googleusercontent.com"     # Option B only
# client_secret = "..."                            # Option B only
# refresh_token = "..."                            # Option B only
